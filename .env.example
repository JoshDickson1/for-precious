# ── Browser-safe (VITE_ prefix is bundled into the client) ──────────────────
VITE_SITE_URL=https://forprecious.love
# sha256 of the passphrase. Default below is sha256("precious"). CHANGE IT.
# Missing or invalid = the whole site fails closed (that is intentional).
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('your phrase').digest('hex'))"
VITE_GATE_HASH=157fc55121ab2c59852c35d78aca98d840047e5d9668c423e4d3b146e1577901
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (Supabase Edge Function secrets — never use VITE_) ──────────
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=For Precious <notes@forprecious.love>
EMAIL_REPLY_TO=
SITE_URL=https://forprecious.love
# Derived notes key for the notes Edge Function. It is NOT bundled into the browser.
# Generate (must use the same passphrase as VITE_GATE_HASH):
# node -e "const c=require('crypto');console.log(c.createHash('sha256').update(('your phrase').trim().toLowerCase()+':for-precious-notes').digest('hex'))"
SITE_KEY=
# Where shared plans, check-ins and answers are sent. Required.
CREATOR_NOTIFICATION_EMAIL=
# Optional: lock subscriptions to one address. Strongly recommended.
ALLOWED_SUBSCRIBER_EMAIL=
# Any long random string. Must match the x-scheduler-secret header in cron.
EMAIL_SCHEDULER_SECRET=
# Local hour (0-23) the daily email goes out, in each subscriber's timezone.
DAILY_EMAIL_HOUR=7
